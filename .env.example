# PolyShift Environment Configuration
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///backend/data/polyshift.db

# Sandboxed Execution Safeguards
EXECUTION_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_BYTES=1048576
MAX_OUTPUT_BYTES=65536

# Optional Neural AI Integration (Deterministic Engine runs seamlessly without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_GEMINI=gemini-2.5-flash
AI_MODEL_OPENAI=gpt-4o-mini
